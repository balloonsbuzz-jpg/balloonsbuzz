# Caddy on the host: HTTPS (certificates from Let's Encrypt, renewed automatically) in front
# of the `web` container. Replace the domain, then:  sudo cp Caddyfile /etc/caddy/Caddyfile && sudo systemctl reload caddy
app.balloonsbuzz.com {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# web listens on 127.0.0.1:WEB_PORT (8080 by default); nginx inside it serves the
	# dashboard and passes /api and /webhook to the API.
	reverse_proxy 127.0.0.1:8080 {
		# keep the live inbox (Server-Sent Events) streaming
		flush_interval -1
	}

	log {
		output file /var/log/caddy/balloonsbuzz.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
