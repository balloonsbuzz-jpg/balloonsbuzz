# Copy to .env and fill in. Never commit .env.

# ---- database: Supabase (recommended) ----
# Supabase dashboard -> Connect -> "Session pooler" URI (port 5432; works on IPv4).
# Replace [YOUR-PASSWORD] with the database password. URL-encode special characters
# in the password (@ -> %40, # -> %23, / -> %2F, : -> %3A).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Tests create and drop throwaway databases; point this at the same server's `postgres` db:
DATABASE_URL_TEST_ADMIN=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
PGSSL=true

# ---- database: local Docker alternative (docker-compose.db.yml) ----
# POSTGRES_USER=bb
# POSTGRES_PASSWORD=change_me
# POSTGRES_DB=balloonsbuzz
# DATABASE_URL=postgres://bb:change_me@127.0.0.1:55432/balloonsbuzz
# DATABASE_URL_TEST_ADMIN=postgres://bb:change_me@127.0.0.1:55432/postgres
# PGSSL=false

# ---- AI (DeepSeek, same as Whapter). A key saved in the AI Agent screen overrides this. ----
DEEPSEEK_API_KEY=

# ---- api ----
JWT_SECRET=                  # 48+ random bytes, e.g. openssl rand -base64 48
# 32-byte hex key used to encrypt API keys/tokens stored in the DB (openssl rand -hex 32)
ENCRYPTION_KEY=
FRONTEND_URL=http://localhost:5173

# ---- full stack (docker-compose.yml) ----
WEB_PORT=8080
COOKIE_SECURE=true           # keep true behind HTTPS; localhost counts as secure in browsers

# ---- supabase project (optional, not used by the app) ----
SUPABASE_URL=
SUPABASE_PROJECT_REF=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=

# ---- whatsapp / meta cloud api ----
META_APP_ID=
META_APP_SECRET=                     # verifies webhook signatures (required to accept webhooks)
META_API_VERSION=v21.0
META_GRAPH_BASE_URL=https://graph.facebook.com
WHATSAPP_WEBHOOK_VERIFY_TOKEN=       # any long random string; paste the same in Meta's webhook settings
WHATSAPP_ACCESS_TOKEN=               # permanent System User token (or save one in Settings -> WhatsApp)
PUBLIC_BASE_URL=                     # public https origin Meta calls, e.g. https://wa.balloonsbuzz.com
WORKER_CONCURRENCY=4

# ---- gallery photos (M5) ----
# Stored in Supabase Storage (public bucket "gallery", created automatically) when these are set:
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=gallery
# GALLERY_STORAGE=local              # or keep photos on this machine (served at /files/gallery)
# GALLERY_LOCAL_DIR=.data/gallery
# Google Drive sync: share the folder "Anyone with the link" and create an API key with the Drive API enabled
GDRIVE_API_KEY=
GDRIVE_FOLDER_ID=1dWyYHT5_0aFBMXIpkCLVDv9OL6Mep-7q
GDRIVE_SYNC_INTERVAL_MIN=30
# Optional: real road distances (otherwise straight line x road factor)
GOOGLE_MAPS_API_KEY=

# ---- AI agent (M6) ----
AI_DEBOUNCE_MS=2500                   # wait for a customer's follow-up messages before replying
