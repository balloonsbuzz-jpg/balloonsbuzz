{
  "name": "@bb/backend",
  "private": true,
  "version": "0.1.0",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest --runInBand",
    "worker": "node src/worker.js",
    "dev:worker": "node --watch src/worker.js",
    "test:unit": "jest --config jest.unit.config.js",
    "gallery:import": "node scripts/gallery-import.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "sharp": "^0.33.5",
    "winston": "^3.17.0",
    "yauzl": "^3.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "yazl": "^2.5.1"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 60000,
    "roots": [
      "<rootDir>/tests"
    ],
    "globalSetup": "<rootDir>/tests/setup/globalSetup.js",
    "globalTeardown": "<rootDir>/tests/setup/globalTeardown.js",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tests/unit/"
    ]
  }
}
